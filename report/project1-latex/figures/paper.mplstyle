font.family: serif
font.serif: Liberation Serif, DejaVu Serif
mathtext.fontset: stix
font.size: 8.5
axes.labelsize: 8.5
axes.titlesize: 8.5
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.frameon: False
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True
axes.grid: True
axes.grid.axis: y
grid.color: DDDDDD
grid.linewidth: 0.6
axes.linewidth: 0.7
xtick.major.width: 0.7
ytick.major.width: 0.7
xtick.major.size: 3
ytick.major.size: 3
lines.linewidth: 1.6
lines.markersize: 4
pdf.fonttype: 42
ps.fonttype: 42
savefig.bbox: tight
savefig.pad_inches: 0.04
figure.dpi: 150
